{
  "name": "elsewhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "maps:index": "node scripts/build-country-index.mjs",
    "maps:build": "node scripts/build-map-assets.mjs",
    "maps:basics": "node scripts/build-country-basics.mjs",
    "maps:countries": "node scripts/build-countries.mjs",
    "maps:gazetteer": "node --import tsx scripts/build-gazetteer.mjs",
    "content:check": "node --import tsx scripts/validate-content.ts",
    "content:generate": "node --import tsx pipeline/generate/cli.ts",
    "content:verify": "node --import tsx pipeline/validate/cli.ts",
    "content:review": "node --import tsx pipeline/review/cli.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "globe.gl": "^2.45.0",
    "lucide-react": "^1.31.0",
    "next": "^16.4.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.6.0",
    "three": "^0.180.0",
    "three-conic-polygon-geometry": "2.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "d3-geo": "^3.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "mapshaper": "^0.7.68",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
